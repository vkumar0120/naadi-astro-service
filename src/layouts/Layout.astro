---
interface Props {
  title: string;
  description?: string;
  keywords?: string;
  image?: string;
  url?: string;
}

const { 
  title, 
  description = "Sree Agasthiya Maha Siva Nadi Astrology offers authentic Nadi Astrology in Vaitheeswaran Koil and Trichy. Explore ancient palm leaf predictions, Nadi Jothidam, Agasthiya Nadi, Siva Nadi, karmic guidance, life path analysis, past-life insights, spiritual remedies, and personalized astrology guidance by Guruji Thillaimani.",
  keywords = "Sree Agasthiya Maha Siva Nadi Astrology, Nadi Astrology, nadi astrology, nadi jothidam, palm leaf astrology, agasthiya nadi astrology, siva nadi astrology, vaitheeswaran koil nadi, trichy nadi astrology, authentic nadi reading, ancient palm leaf predictions, karmic guidance, past life reading, spiritual remedies, astrology consultation, tamil nadu astrology, guruji thillaimani, online nadi astrology, personalized nadi reading, traditional astrology, vaitheeswaran koil astrologer, divine palm leaf guidance",
  image = "https://naadiastroservice.com/assets/images/nadi/mem2.jpg",
  url = Astro.url.href
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
